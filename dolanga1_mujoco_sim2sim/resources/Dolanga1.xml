    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1=".1 .2 .3" rgb2=".2 .3 .4"/>
    <material name="grid" texture="grid" texrepeat="10 10" reflectance="0.1"/>

    <!-- base_link.STL ~783k faces exceeds MuJoCo mesh limit (~200k); use box visual matching URDF collision. -->
    <mesh name="LF_hip_link" file="LF_hip_link.STL"/>
    <mesh name="LF_thigh_link" file="LF_thigh_link.STL"/>
    <mesh name="LF_calf_link" file="LF_calf_link.STL"/>
